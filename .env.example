# --- LLM (free tiers) -------------------------------------------------------
GEMINI_API_KEY=            # aistudio.google.com → Get API key (free)
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=              # optional fallback — console.groq.com (free)

# --- Database (Supabase free tier) — run db/schema.sql first ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server-only; never expose to the browser

# --- Handoff: Gmail primary, Telegram optional fallback ---------------------
GMAIL_USER=                # the Gmail address that sends handoffs, e.g. aangan.calldesk@gmail.com
GMAIL_APP_PASSWORD=        # myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_FROM_NAME=Aangan Call Desk
HANDOFF_EMAIL_DESIGNERS=   # comma-separated; qualified leads
HANDOFF_EMAIL_ESCALATION=  # Nikhil / studio head; complaints + guardrail alerts
HANDOFF_EMAIL_FRONTDESK=   # missed calls + one-question follow-ups
# Optional fallbacks
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=
RESEND_API_KEY=            # only used if GMAIL_* is not set

# --- Scheduling (Cal.com free) ----------------------------------------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_ATTENDEE_EMAIL=     # studio inbox that receives booking confirmations

# --- CRM (HubSpot free) — qualified calls become deals ----------------------
HUBSPOT_TOKEN=             # Settings → Integrations → Private apps (contacts + deals write scopes)
HUBSPOT_PIPELINE=default
HUBSPOT_STAGE_NEW=qualifiedtobuy
HUBSPOT_STAGE_BOOKED=appointmentscheduled

# --- Security ---------------------------------------------------------------
VAANI_WEBHOOK_SECRET=      # same value set on the Vaani webhook + tool URLs
DASHBOARD_PASSWORD=        # basic-auth lock for the dashboard (any username)

# --- Cost tracking ----------------------------------------------------------
BILLING_MODE=free          # "free" → billed cost 0; "paid" → bill at the rates below
SHADOW_LLM_INPUT_USD_PER_M=0.30
SHADOW_LLM_OUTPUT_USD_PER_M=2.50
SHADOW_VOICE_USD_PER_MIN=0.05   # set from your voice platform's paid per-minute rate
